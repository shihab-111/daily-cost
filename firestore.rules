rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Security Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(ownerUid) {
      return isVerified() && request.auth.uid == ownerUid;
    }

    // --- Validation Blueprints ---
    function isValidUserSettings(data) {
      return data.keys().hasAll([
          'userId', 'businessName', 'ownerName', 'currencyCode', 'currencySymbol',
          'lowStockThreshold', 'usdToBdtRate', 'personalMonthlyBudget',
          'address', 'phone', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'businessName', 'ownerName', 'currencyCode', 'currencySymbol',
          'lowStockThreshold', 'usdToBdtRate', 'personalMonthlyBudget',
          'address', 'phone', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 140
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 120
        && data.currencyCode in ['BDT', 'USD']
        && data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 6
        && data.lowStockThreshold is int && data.lowStockThreshold >= 0 && data.lowStockThreshold <= 10000
        && (data.usdToBdtRate is int || data.usdToBdtRate is float) && data.usdToBdtRate >= 1 && data.usdToBdtRate <= 10000
        && (data.personalMonthlyBudget is int || data.personalMonthlyBudget is float) && data.personalMonthlyBudget >= 0 && data.personalMonthlyBudget <= 999999999
        && data.address is string && data.address.size() <= 240
        && data.phone is string && data.phone.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpenseFields(data) {
      return data.mode in ['business', 'personal']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.description is string && data.description.size() <= 4000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 64 && data.category.matches('^[a-zA-Z0-9_\\-]+$')
        && (data.amount is int || data.amount is float) && data.amount >= 0 && data.amount <= 999999999
        && data.currency in ['BDT', 'USD']
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.paymentMethod in ['bKash', 'Nagad', 'Rocket', 'Bank Transfer', 'Cash', 'Card'];
    }

    function isValidExpenseMeta(data) {
      return isValidId(data.userId)
        && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 254
        && data.adAccountId is string && data.adAccountId.size() <= 120
        && data.campaignName is string && data.campaignName.size() <= 160
        && data.partnerOrAgency is string && data.partnerOrAgency.size() <= 160
        && data.modelName is string && data.modelName.size() <= 120
        && data.photographerName is string && data.photographerName.size() <= 120
        && data.studioName is string && data.studioName.size() <= 120
        && data.vendorOrCourier is string && data.vendorOrCourier.size() <= 160
        && data.receiptThumb is string && data.receiptThumb.size() <= 80000
        && data.receiptCount is int && data.receiptCount >= 0 && data.receiptCount <= 10
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpense(data) {
      return data.keys().hasAll([
          'userId', 'userEmail', 'mode', 'title', 'description', 'category', 'amount', 'currency',
          'date', 'paymentMethod', 'adAccountId', 'campaignName', 'partnerOrAgency',
          'modelName', 'photographerName', 'studioName', 'vendorOrCourier',
          'receiptThumb', 'receiptCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'userEmail', 'mode', 'title', 'description', 'category', 'amount', 'currency',
          'date', 'paymentMethod', 'adAccountId', 'campaignName', 'partnerOrAgency',
          'modelName', 'photographerName', 'studioName', 'vendorOrCourier',
          'receiptThumb', 'receiptCount', 'createdAt', 'updatedAt'
        ])
        && isValidExpenseFields(data)
        && isValidExpenseMeta(data);
    }

    function isValidReceiptAsset(data) {
      return data.keys().hasAll(['expenseId', 'userId', 'fileName', 'mimeType', 'width', 'height', 'sizeBytes', 'dataUrl', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['expenseId', 'userId', 'fileName', 'mimeType', 'width', 'height', 'sizeBytes', 'dataUrl', 'createdAt', 'updatedAt'])
        && isValidId(data.expenseId)
        && isValidId(data.userId)
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200
        && data.mimeType in ['image/jpeg', 'image/webp', 'image/png']
        && data.width is int && data.width >= 1 && data.width <= 8000
        && data.height is int && data.height >= 1 && data.height <= 8000
        && data.sizeBytes is int && data.sizeBytes >= 1 && data.sizeBytes <= 700000
        && data.dataUrl is string && data.dataUrl.size() >= 10 && data.dataUrl.size() <= 700000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'userId', 'userEmail', 'name', 'sku', 'category', 'purchaseCost', 'sellingPrice', 'currency',
          'stockQty', 'lowStockThreshold', 'notes', 'thumbnailUrl', 'photoCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'userEmail', 'name', 'sku', 'category', 'purchaseCost', 'sellingPrice', 'currency',
          'stockQty', 'lowStockThreshold', 'notes', 'thumbnailUrl', 'photoCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 254
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 60 && data.sku.matches('^[a-zA-Z0-9_\\-]+$')
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && (data.purchaseCost is int || data.purchaseCost is float) && data.purchaseCost >= 0 && data.purchaseCost <= 999999999
        && (data.sellingPrice is int || data.sellingPrice is float) && data.sellingPrice >= 0 && data.sellingPrice <= 999999999
        && data.currency in ['BDT', 'USD']
        && data.stockQty is int && data.stockQty >= 0 && data.stockQty <= 9999999
        && data.lowStockThreshold is int && data.lowStockThreshold >= 0 && data.lowStockThreshold <= 99999
        && data.notes is string && data.notes.size() <= 4000
        && data.thumbnailUrl is string && data.thumbnailUrl.size() <= 80000
        && data.photoCount is int && data.photoCount >= 0 && data.photoCount <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProductPhoto(data) {
      return data.keys().hasAll(['productId', 'userId', 'fileName', 'mimeType', 'caption', 'width', 'height', 'sizeBytes', 'dataUrl', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['productId', 'userId', 'fileName', 'mimeType', 'caption', 'width', 'height', 'sizeBytes', 'dataUrl', 'createdAt', 'updatedAt'])
        && isValidId(data.productId)
        && isValidId(data.userId)
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200
        && data.mimeType in ['image/jpeg', 'image/webp', 'image/png']
        && data.caption is string && data.caption.size() <= 300
        && data.width is int && data.width >= 1 && data.width <= 8000
        && data.height is int && data.height >= 1 && data.height <= 8000
        && data.sizeBytes is int && data.sizeBytes >= 1 && data.sizeBytes <= 700000
        && data.dataUrl is string && data.dataUrl.size() >= 10 && data.dataUrl.size() <= 700000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll([
          'userId', 'name', 'phone', 'email', 'address', 'district', 'notes',
          'totalOrders', 'totalSpent', 'lastOrderDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'name', 'phone', 'email', 'address', 'district', 'notes',
          'totalOrders', 'totalSpent', 'lastOrderDate', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && data.phone is string && data.phone.size() >= 11 && data.phone.size() <= 20
        && data.email is string && data.email.size() <= 140
        && data.address is string && data.address.size() <= 240
        && data.district is string && data.district.size() <= 80
        && data.notes is string && data.notes.size() <= 1000
        && data.totalOrders is int && data.totalOrders >= 0 && data.totalOrders <= 999999
        && (data.totalSpent is int || data.totalSpent is float) && data.totalSpent >= 0 && data.totalSpent <= 999999999
        && data.lastOrderDate is string && data.lastOrderDate.size() <= 10
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['userId', 'actorEmail', 'mode', 'action', 'summary', 'entityType', 'entityId', 'amount', 'currency', 'createdAt'])
        && data.keys().hasOnly(['userId', 'actorEmail', 'mode', 'action', 'summary', 'entityType', 'entityId', 'amount', 'currency', 'createdAt'])
        && isValidId(data.userId)
        && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 254
        && data.mode in ['business', 'personal']
        && data.action in [
          'expense_created', 'expense_updated', 'expense_deleted',
          'product_created', 'product_updated', 'product_deleted',
          'customer_created', 'customer_updated', 'customer_deleted',
          'receipt_created', 'receipt_deleted'
        ]
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 240
        && data.entityType in ['expense', 'product', 'customer', 'receipt']
        && isValidId(data.entityId)
        && (data.amount is int || data.amount is float) && data.amount >= 0 && data.amount <= 999999999
        && data.currency in ['BDT', 'USD']
        && data.createdAt is timestamp;
    }

    function isValidReceiptBranding(data) {
      return data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 140
        && data.businessTagline is string && data.businessTagline.size() <= 160
        && data.businessPhone is string && data.businessPhone.size() <= 40
        && data.businessAddress is string && data.businessAddress.size() <= 240
        && data.memoTitle is string && data.memoTitle.size() >= 1 && data.memoTitle.size() <= 60
        && data.logoType in ['monogram', 'uploaded', 'minimal_text']
        && data.logoText is string && data.logoText.size() <= 8
        && data.logoDataUrl is string && data.logoDataUrl.size() <= 80000
        && data.logoSize in ['sm', 'md', 'lg']
        && data.logoPosition in ['left', 'center']
        && data.textStyle in ['modern_sans', 'classic_serif', 'mono_thermal']
        && data.fontSizeScale in ['sm', 'md', 'lg']
        && data.accentColor is string && data.accentColor.size() == 7 && data.accentColor.matches('^#[0-9a-fA-F]{6}$')
        && data.headerBgColor is string && data.headerBgColor.size() == 7 && data.headerBgColor.matches('^#[0-9a-fA-F]{6}$')
        && data.paperStyle in ['a4_clean', 'pos_thermal', 'dark_luxury']
        && data.footerNote is string && data.footerNote.size() <= 400;
    }

    function isValidReceiptTemplate(data) {
      return data.keys().hasAll([
          'userId', 'businessName', 'businessTagline', 'businessPhone', 'businessAddress', 'memoTitle',
          'logoType', 'logoText', 'logoDataUrl', 'logoSize', 'logoPosition',
          'textStyle', 'fontSizeScale', 'accentColor', 'headerBgColor',
          'paperStyle', 'footerNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'businessName', 'businessTagline', 'businessPhone', 'businessAddress', 'memoTitle',
          'logoType', 'logoText', 'logoDataUrl', 'logoSize', 'logoPosition',
          'textStyle', 'fontSizeScale', 'accentColor', 'headerBgColor',
          'paperStyle', 'footerNote', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && isValidReceiptBranding(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReceiptCustomerAndItems(data) {
      return data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 140
        && data.customerPhone is string && data.customerPhone.size() <= 40
        && data.customerEmail is string && data.customerEmail.size() <= 140
        && data.customerAddress is string && data.customerAddress.size() <= 240
        && data.customerDistrict is string && data.customerDistrict.size() <= 80
        && data.deliveryZone in ['inside_dhaka', 'outside_dhaka', 'pickup']
        && data.courierName is string && data.courierName.size() <= 80
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 30
        && data.items[0] is map
        && data.items[0].keys().hasAll(['name', 'sku', 'qty', 'unitPrice', 'total'])
        && data.items[0].keys().hasOnly(['name', 'sku', 'qty', 'unitPrice', 'total'])
        && data.items[0].name is string && data.items[0].name.size() >= 1 && data.items[0].name.size() <= 160
        && data.items[0].sku is string && data.items[0].sku.size() <= 60
        && (data.items[0].qty is int || data.items[0].qty is float) && data.items[0].qty >= 1 && data.items[0].qty <= 99999
        && (data.items[0].unitPrice is int || data.items[0].unitPrice is float) && data.items[0].unitPrice >= 0 && data.items[0].unitPrice <= 999999999
        && (data.items[0].total is int || data.items[0].total is float) && data.items[0].total >= 0 && data.items[0].total <= 999999999;
    }

    function isValidReceiptAmountsAndMeta(data) {
      return isValidId(data.userId)
        && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 254
        && data.receiptNumber is string && data.receiptNumber.size() >= 1 && data.receiptNumber.size() <= 50 && data.receiptNumber.matches('^[a-zA-Z0-9_\\-]+$')
        && data.issueDate is string && data.issueDate.size() == 10 && data.issueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.issueTime is string && data.issueTime.size() <= 30
        && data.status in ['paid', 'partial', 'cod', 'unpaid']
        && data.paymentMethod in ['Cash on Delivery', 'bKash', 'Nagad', 'Rocket', 'Bank Transfer', 'Cash', 'Card']
        && data.currency in ['BDT', 'USD']
        && (data.subtotal is int || data.subtotal is float) && data.subtotal >= 0 && data.subtotal <= 999999999
        && (data.deliveryCharge is int || data.deliveryCharge is float) && data.deliveryCharge >= 0 && data.deliveryCharge <= 999999999
        && (data.discountAmount is int || data.discountAmount is float) && data.discountAmount >= 0 && data.discountAmount <= 999999999
        && (data.vatPercent is int || data.vatPercent is float) && data.vatPercent >= 0 && data.vatPercent <= 100
        && (data.vatAmount is int || data.vatAmount is float) && data.vatAmount >= 0 && data.vatAmount <= 999999999
        && (data.grandTotal is int || data.grandTotal is float) && data.grandTotal >= 0 && data.grandTotal <= 999999999
        && (data.paidAmount is int || data.paidAmount is float) && data.paidAmount >= 0 && data.paidAmount <= 999999999
        && (data.dueAmount is int || data.dueAmount is float) && data.dueAmount >= 0 && data.dueAmount <= 999999999
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomerReceipt(data) {
      return data.keys().hasAll([
          'userId', 'userEmail', 'receiptNumber', 'issueDate', 'issueTime', 'memoTitle', 'status', 'paymentMethod',
          'businessName', 'businessTagline', 'businessPhone', 'businessAddress',
          'logoType', 'logoText', 'logoDataUrl', 'logoSize', 'logoPosition',
          'textStyle', 'fontSizeScale', 'accentColor', 'headerBgColor', 'paperStyle',
          'customerName', 'customerPhone', 'customerEmail', 'customerAddress',
          'customerDistrict', 'deliveryZone', 'courierName', 'items', 'currency',
          'subtotal', 'deliveryCharge', 'discountAmount', 'vatPercent', 'vatAmount',
          'grandTotal', 'paidAmount', 'dueAmount', 'footerNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'userEmail', 'receiptNumber', 'issueDate', 'issueTime', 'memoTitle', 'status', 'paymentMethod',
          'businessName', 'businessTagline', 'businessPhone', 'businessAddress',
          'logoType', 'logoText', 'logoDataUrl', 'logoSize', 'logoPosition',
          'textStyle', 'fontSizeScale', 'accentColor', 'headerBgColor', 'paperStyle',
          'customerName', 'customerPhone', 'customerEmail', 'customerAddress',
          'customerDistrict', 'deliveryZone', 'courierName', 'items', 'currency',
          'subtotal', 'deliveryCharge', 'discountAmount', 'vatPercent', 'vatAmount',
          'grandTotal', 'paidAmount', 'dueAmount', 'footerNote', 'createdAt', 'updatedAt'
        ])
        && isValidReceiptBranding(data)
        && isValidReceiptCustomerAndItems(data)
        && isValidReceiptAmountsAndMeta(data);
    }

    function isValidExpenseCategory(data) {
      return data.keys().hasAll(['userId', 'mode', 'key', 'label', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'mode', 'key', 'label', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.mode in ['business', 'personal']
        && data.key is string && data.key.size() >= 1 && data.key.size() <= 64 && data.key.matches('^[a-zA-Z0-9_\\-]+$')
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpenseCategorySeed(data) {
      return data.keys().hasAll(['userId', 'seeded', 'createdAt'])
        && data.keys().hasOnly(['userId', 'seeded', 'createdAt'])
        && isValidId(data.userId)
        && data.seeded is bool && data.seeded == true
        && data.createdAt is timestamp;
    }

    // --- Collection Rules (Strict Per-Tenant userId Isolation) ---

    // 1. Per-User Settings (/settings/{userId})
    match /settings/{userId} {
      allow get: if isVerified() && isValidId(userId) && isOwner(userId) && (resource == null || existing().userId == request.auth.uid);
      allow list: if isVerified() && resource.data.userId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserSettings(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserSettings(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'businessName', 'ownerName', 'currencyCode', 'currencySymbol',
          'lowStockThreshold', 'usdToBdtRate', 'personalMonthlyBudget',
          'address', 'phone', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // 2. Expenses (Business + Personal modes, strictly owned by userId)
    match /expenses/{expenseId} {
      allow get: if isVerified() && isValidId(expenseId) && existing().userId == request.auth.uid;
      allow list: if isVerified() && resource.data.userId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(expenseId)
        && isValidExpense(incoming())
        && incoming().userId == request.auth.uid
        && incoming().userEmail == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(expenseId)
        && isValidExpense(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().userEmail == existing().userEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'mode', 'title', 'description', 'category', 'amount', 'currency', 'date', 'paymentMethod',
            'adAccountId', 'campaignName', 'partnerOrAgency', 'modelName', 'photographerName',
            'studioName', 'vendorOrCourier', 'receiptThumb', 'receiptCount', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['receiptThumb', 'receiptCount', 'updatedAt'])
        );
      allow delete: if isVerified() && isValidId(expenseId) && existing().userId == request.auth.uid;

      match /receipts/{receiptId} {
        allow get: if isVerified() && isValidId(expenseId) && isValidId(receiptId)
          && existing().userId == request.auth.uid
          && exists(/databases/$(database)/documents/expenses/$(expenseId))
          && get(/databases/$(database)/documents/expenses/$(expenseId)).data.userId == request.auth.uid;
        allow list: if isVerified() && resource.data.userId == request.auth.uid;
        allow create: if isVerified()
          && isValidId(expenseId)
          && isValidId(receiptId)
          && isValidReceiptAsset(incoming())
          && incoming().expenseId == expenseId
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/expenses/$(expenseId))
          && get(/databases/$(database)/documents/expenses/$(expenseId)).data.userId == request.auth.uid;
        allow delete: if isVerified() && isValidId(expenseId) && isValidId(receiptId)
          && existing().userId == request.auth.uid
          && exists(/databases/$(database)/documents/expenses/$(expenseId))
          && get(/databases/$(database)/documents/expenses/$(expenseId)).data.userId == request.auth.uid;
        allow update: if false;
      }
    }

    // 3. Products & Inventory (Business Mode, strictly owned by userId)
    match /products/{productId} {
      allow get: if isVerified() && isValidId(productId) && existing().userId == request.auth.uid;
      allow list: if isVerified() && resource.data.userId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().userId == request.auth.uid
        && incoming().userEmail == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(productId)
        && isValidProduct(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().userEmail == existing().userEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'sku', 'category', 'purchaseCost', 'sellingPrice', 'currency',
            'stockQty', 'lowStockThreshold', 'notes', 'thumbnailUrl', 'photoCount', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['stockQty', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['thumbnailUrl', 'photoCount', 'updatedAt'])
        );
      allow delete: if isVerified() && isValidId(productId) && existing().userId == request.auth.uid;

      match /photos/{photoId} {
        allow get: if isVerified() && isValidId(productId) && isValidId(photoId)
          && existing().userId == request.auth.uid
          && exists(/databases/$(database)/documents/products/$(productId))
          && get(/databases/$(database)/documents/products/$(productId)).data.userId == request.auth.uid;
        allow list: if isVerified() && resource.data.userId == request.auth.uid;
        allow create: if isVerified()
          && isValidId(productId)
          && isValidId(photoId)
          && isValidProductPhoto(incoming())
          && incoming().productId == productId
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/products/$(productId))
          && get(/databases/$(database)/documents/products/$(productId)).data.userId == request.auth.uid;
        allow update: if isVerified()
          && isValidId(productId)
          && isValidId(photoId)
          && isValidProductPhoto(incoming())
          && existing().userId == request.auth.uid
          && incoming().productId == existing().productId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/products/$(productId))
          && get(/databases/$(database)/documents/products/$(productId)).data.userId == request.auth.uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'updatedAt']);
        allow delete: if isVerified() && isValidId(productId) && isValidId(photoId)
          && existing().userId == request.auth.uid
          && exists(/databases/$(database)/documents/products/$(productId))
          && get(/databases/$(database)/documents/products/$(productId)).data.userId == request.auth.uid;
      }
    }

    // 4. Customers Directory (Business Mode, strictly owned by userId)
    match /customers/{customerId} {
      allow get: if isVerified() && isValidId(customerId) && existing().userId == request.auth.uid;
      allow list: if isVerified() && resource.data.userId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(customerId)
        && isValidCustomer(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(customerId)
        && isValidCustomer(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'phone', 'email', 'address', 'district', 'notes',
            'totalOrders', 'totalSpent', 'lastOrderDate', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['totalOrders', 'totalSpent', 'lastOrderDate', 'updatedAt'])
        );
      allow delete: if isVerified() && isValidId(customerId) && existing().userId == request.auth.uid;
    }

    // 5. Immutable Activity Logs (strictly owned by userId)
    match /activityLogs/{logId} {
      allow get: if isVerified() && isValidId(logId) && existing().userId == request.auth.uid;
      allow list: if isVerified() && resource.data.userId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(logId)
        && isValidActivityLog(incoming())
        && incoming().userId == request.auth.uid
        && incoming().actorEmail == request.auth.token.email
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 6. Receipt Brand Templates (/receiptTemplates/{templateId} == userId)
    match /receiptTemplates/{templateId} {
      allow get: if isVerified() && isValidId(templateId) && isOwner(templateId) && (resource == null || existing().userId == request.auth.uid);
      allow list: if isVerified() && resource.data.userId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(templateId)
        && isOwner(templateId)
        && isValidReceiptTemplate(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(templateId)
        && isOwner(templateId)
        && isValidReceiptTemplate(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'businessName', 'businessTagline', 'businessPhone', 'businessAddress', 'memoTitle',
          'logoType', 'logoText', 'logoDataUrl', 'logoSize', 'logoPosition',
          'textStyle', 'fontSizeScale', 'accentColor', 'headerBgColor',
          'paperStyle', 'footerNote', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // 7. Generated Customer Receipts (strictly owned by userId)
    match /customerReceipts/{receiptId} {
      allow get: if isVerified() && isValidId(receiptId) && existing().userId == request.auth.uid;
      allow list: if isVerified() && resource.data.userId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(receiptId)
        && isValidCustomerReceipt(incoming())
        && incoming().userId == request.auth.uid
        && incoming().userEmail == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(receiptId)
        && isValidCustomerReceipt(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().userEmail == existing().userEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'receiptNumber', 'issueDate', 'issueTime', 'memoTitle', 'status', 'paymentMethod',
          'businessName', 'businessTagline', 'businessPhone', 'businessAddress',
          'logoType', 'logoText', 'logoDataUrl', 'logoSize', 'logoPosition',
          'textStyle', 'fontSizeScale', 'accentColor', 'headerBgColor', 'paperStyle',
          'customerName', 'customerPhone', 'customerEmail', 'customerAddress',
          'customerDistrict', 'deliveryZone', 'courierName', 'items', 'currency',
          'subtotal', 'deliveryCharge', 'discountAmount', 'vatPercent', 'vatAmount',
          'grandTotal', 'paidAmount', 'dueAmount', 'footerNote', 'updatedAt'
        ]);
      allow delete: if isVerified() && isValidId(receiptId) && existing().userId == request.auth.uid;
    }

    // 8. Customizable Expense Categories (Business & Personal modes, strictly owned by userId)
    match /expenseCategories/{categoryId} {
      allow get: if isVerified() && isValidId(categoryId) && existing().userId == request.auth.uid;
      allow list: if isVerified() && resource.data.userId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(categoryId)
        && isValidExpenseCategory(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(categoryId)
        && isValidExpenseCategory(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().mode == existing().mode
        && incoming().key == existing().key
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['label', 'updatedAt']);
      allow delete: if isVerified() && isValidId(categoryId) && existing().userId == request.auth.uid;
    }

    // 9. One-time Default Category Seed Marker (/expenseCategorySeeds/{userId})
    match /expenseCategorySeeds/{userId} {
      allow get: if isVerified() && isValidId(userId) && isOwner(userId) && (resource == null || existing().userId == request.auth.uid);
      allow list: if false;
      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidExpenseCategorySeed(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
